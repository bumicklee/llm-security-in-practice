# 가나다몰 상담 챗봇 설정 예시 · 복사해서 .env로 쓴다 (cp .env.example .env)
# 모든 값은 가짜다. 실제 API 키를 이 파일에 넣지 않는다.

# 서버는 항상 내 PC에만 묶는다(127.0.0.1 외 값은 앱이 거부한다)
BOT_HOST=127.0.0.1
BOT_PORT=8000

# stub = 모델 없이 정해진 규칙으로 답함(시험 장치 확인용) / openai = OpenAI 호환 주소로 모델 호출
BOT_MODE=stub
# v1(약함) / v2(한 줄 수정) / v3(과잉 거절) / v4(고친 버전) — 시스템 프롬프트 파일과 스텁 동작을 함께 고른다
BOT_PROFILE=v1

# openai 모드일 때만 쓴다. LM Studio 기본 주소는 http://localhost:1234/v1 (공식 문서)
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=local-model
LLM_API_KEY=lm-studio-FAKE-KEY
LLM_TEMPERATURE=0.7

# 앱이 주문 소유자를 확인하는가(on/off). off는 5장·7장 실습에서 "앱이 안 막으면?"을 보려고 쓴다
APP_AUTHZ=on
# 응답에 trace(도구 호출 기록·검색 문서)를 넣는가. 시험 환경 전용. 운영에서는 0
EXPOSE_TRACE=1
# /admin/fixtures, /admin/reset, /admin/tool-log 사용 여부. 시험 환경 전용
ADMIN_ENDPOINTS=1
# 스텁 모드의 흔들림 재현용 씨앗 값
STUB_SEED=42
# 시험용 문서 폴더(기본은 자리표시만 든 공개 폴더)
FIXTURES_DIR=docs/fixtures-injected
# 접속 로그(1=켬, 0=끔)
BOT_ACCESS_LOG=1
# 프로필 대신 이 파일을 시스템 프롬프트로 쓴다(비우면 프로필 기본 파일). 12.6 실습용
SYSTEM_PROMPT_FILE=
